{
  "name": "nuxt-endpoints",
  "version": "0.1.1",
  "description": "Runtime-validated contracts, status-typed clients, and OpenAPI for Nuxt server routes.",
  "keywords": [
    "api-contract",
    "effect",
    "effect-schema",
    "fetch",
    "nitro",
    "nuxt",
    "nuxt-module",
    "nuxt4",
    "openapi",
    "runtime-validation",
    "server-routes",
    "standard-schema",
    "type-safe",
    "valibot",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/nuxt-endpoints/nuxt-endpoints#readme",
  "bugs": {
    "url": "https://github.com/nuxt-endpoints/nuxt-endpoints/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Yoshinori Ishii",
    "email": "yoshinori.ishii@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-endpoints/nuxt-endpoints.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./effect": {
      "types": "./dist/runtime/effect.d.ts",
      "import": "./dist/runtime/effect.js"
    },
    "./query": {
      "types": "./dist/runtime/query.d.ts",
      "import": "./dist/runtime/query.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "check": "oxfmt --check && oxlint src test --ignore-path .gitignore --ignore-pattern 'test/fixtures/**' --type-check --tsconfig=tsconfig.test.json && oxlint playground site test/fixtures --ignore-path .gitignore && vitest run && NUXT_ENDPOINTS_E2E=1 vitest run test/integration",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "site:dev": "node site/scripts/generate-magic-tokens.mjs && nuxi dev site",
    "site:generate": "node site/scripts/generate-magic-tokens.mjs && nuxi generate site",
    "site:preview": "nuxi preview site",
    "prepack": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src test --ignore-path .gitignore --ignore-pattern 'test/fixtures/**' --type-check --tsconfig=tsconfig.test.json && oxlint playground site test/fixtures --ignore-path .gitignore",
    "lint:fix": "oxlint src test --ignore-path .gitignore --ignore-pattern 'test/fixtures/**' --type-check --tsconfig=tsconfig.test.json --fix && oxlint playground site test/fixtures --ignore-path .gitignore --fix",
    "test": "vitest run",
    "test:e2e": "NUXT_ENDPOINTS_E2E=1 vitest run test/integration",
    "test:package": "node scripts/smoke-packed-package.mjs",
    "typecheck": "oxlint src --type-check --tsconfig=tsconfig.json",
    "test:typecheck": "oxlint src test --ignore-pattern 'test/fixtures/**' --type-check --tsconfig=tsconfig.test.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@nuxt/kit": "^4.5.0",
    "@nuxt/schema": "^4.5.0",
    "@valibot/to-json-schema": "^1.7.1",
    "h3": "^1.12.0",
    "jiti": "^2.7.0",
    "nitropack": "^2.10.0",
    "scule": "^1.3.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@iconify-json/lucide": "^1.2.113",
    "@iconify-json/simple-icons": "^1.2.86",
    "@nuxt/content": "^3.14.0",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.3",
    "@shikijs/magic-move": "^4.2.0",
    "@tanstack/vue-query": "^5.101.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "effect": "^3.21.3",
    "nuxt": "^4.5.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.61.1",
    "shiki": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "valibot": "^1.4.1",
    "vitest": "^2.1.9",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "effect": "^3.21.0",
    "nuxt": "^4.5.0",
    "valibot": "^1.4.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/vue-query": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
